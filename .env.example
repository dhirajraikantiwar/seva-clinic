# Seva Clinic — environment variables (all optional in v1)
#
# The app runs fully on local seed data with NO environment variables set.
# Fill these in only when you connect Supabase (see README → "Connecting Supabase").
# Copy this file to `.env` for local use. Never commit a real `.env`.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
